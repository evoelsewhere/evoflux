{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "evoflux-jira",
  "description": "Jira Data Center task workflows and read-only tools for EvoFlux.",
  "version": "0.1.2",
  "author": {
    "name": "EvoFlux",
    "url": "https://github.com/evoelsewhere/evoflux"
  },
  "homepage": "https://github.com/evoelsewhere/evoflux/tree/main/plugins/jira",
  "repository": "https://github.com/evoelsewhere/evoflux",
  "license": "Apache-2.0",
  "keywords": [
    "jira",
    "tasks",
    "project-management"
  ],
  "extensions": {
    "evoflux.mcp": {
      "servers": {
        "jira": {
          "capabilities": [
            "webbridge-safe"
          ]
        }
      }
    },
    "evoflux.credentials": {
      "fields": [
        {
          "key": "base_url",
          "label": "Jira URL",
          "type": "url",
          "env": "JIRA_URL",
          "required": true,
          "placeholder": "https://jira.example.com/jira9",
          "description": "Base URL for the Jira Data Center instance, including any context path."
        },
        {
          "key": "api_token",
          "label": "PAT / API token",
          "type": "secret",
          "env": "JIRA_API_TOKEN",
          "required": true,
          "description": "Stored by EvoFlux outside the plugin package and injected only into its MCP process."
        },
        {
          "key": "verify_ssl",
          "label": "Verify TLS certificates",
          "type": "boolean",
          "env": "JIRA_VERIFY_SSL",
          "default": true,
          "description": "Disable only for a controlled development server."
        }
      ]
    }
  }
}

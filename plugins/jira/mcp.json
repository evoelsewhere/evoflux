{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "jira": {
      "type": "stdio",
      "command": "python",
      "args": [
        "${PLUGIN_ROOT}/server.py"
      ],
      "env": {
        "JIRA_CONNECTIONS_FILE": "${PLUGIN_DATA}/connections.json"
      },
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}

{
  "schema_version": 1,
  "format": "pptx",
  "baseline_id": "powerpoint-office-like-baseline",
  "id": "html-first-example-dna",
  "deck": {
    "communication_job": {
      "audience": "product stakeholders",
      "decision": "approve the proposed direction",
      "narrative_outcome": "understand the decision and its evidence",
      "language": "en",
      "duration_minutes": 5
    },
    "visual_signature": {
      "mood": "clear and editorial",
      "palette": "dark canvas with cyan emphasis",
      "type_roles": ["title", "body", "source"],
      "spacing_rhythm_px": 8,
      "image_treatment": "plain rectangular raster",
      "motion_policy": "none"
    },
    "canvas": {
      "width": 1280,
      "height": 720,
      "unit": "px",
      "aspect_ratio": "16:9",
      "safe_area_px": {"left": 32, "right": 32, "top": 24, "bottom": 24}
    },
    "layout_family": ["cover"],
    "representation_policy": {
      "uniform-text": "hybrid-editable",
      "plain-raster-image": "hybrid-editable",
      "decorative-composition": "flattened-fidelity",
      "powerpoint-reference": "unverified"
    },
    "fidelity_target": {
      "target_score": 90,
      "raster_targets": {
        "metric": "normalized-rgb-rmse-similarity-v1",
        "per_slide_similarity_min": 0.9,
        "deck_median_similarity_min": 0.95,
        "manual_review_below_threshold": true
      },
      "hard_failures": [
        "blank-slide",
        "wrong-aspect-ratio",
        "content-overflow",
        "title-wrap",
        "missing-asset",
        "missing-glyph",
        "visual-duplication",
        "corrupt-openxml",
        "wrong-template-map",
        "unrendered-reopened-slide"
      ],
      "render_surfaces": [
        "source-preview",
        "flattened-shell",
        "reopened-plugin-preview",
        "powerpoint-reference"
      ]
    },
    "known_gaps": ["Microsoft PowerPoint reference render is not supplied"]
  },
  "tokens": {
    "semantic-colors": {"canvas": "#07111f", "primary-ink": "#ffffff", "emphasis": "#22d3ee"},
    "type-roles": {"title": "Arial Bold", "body": "Arial", "source": "Arial"},
    "spacing": {"baseline_px": 8},
    "grid": {"columns": 12},
    "borders": {"default_px": 1},
    "radii": {"default_px": 0},
    "effects": {"shadow": "none"},
    "imagery": {"fit": "fill"},
    "charts": {"mode": "flattened-fidelity"},
    "tables": {"mode": "flattened-fidelity"},
    "icons": {"mode": "flattened-fidelity"},
    "source-notes": {"prefix": "[Sources]"}
  },
  "slides": [
    {
      "id": "html-first",
      "narrative_role": "opening",
      "takeaway": "HTML owns the visual composition",
      "archetype": "cover",
      "dominant_object": "headline",
      "reading_order": ["title", "supporting-copy"],
      "density": "standard",
      "editable_intent": ["title"],
      "flattened_intent": ["background", "decorative-effects"],
      "source_ids": [],
      "risk_flags": ["font-metric-drift"]
    }
  ]
}

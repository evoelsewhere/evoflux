{
  "schema_version": 1,
  "project_schema_version": 6,
  "id": "academic-engineering-blueprint",
  "name": "Academic Engineering Blueprint",
  "format": "pptx",
  "baseline_id": "powerpoint-office-like-baseline",
  "extends": "powerpoint-slide-dna.json",
  "purpose": "Measured blue-and-white technical research style for dense architecture, mechanism, comparison, evidence, and defense slides",
  "evidence_basis": {
    "source_kind": "user-supplied-slide-montage",
    "reference_slide_count": 10,
    "canvas_px": [1280, 720],
    "observed_sequence": [
      "identity-and-signature-architecture",
      "prior-limitations-and-central-question",
      "four-contributions",
      "architecture-and-reading-rail",
      "dual-mechanism-and-numbered-explanation",
      "sequence-information-flow",
      "efficiency-comparison",
      "results-and-training-conditions",
      "qualitative-evidence",
      "synthesis-and-defense"
    ]
  },
  "communication_grammar": {
    "slide_equation": [
      "claim-title",
      "technical-evidence",
      "numbered-reading-guide",
      "implication",
      "takeaway-band"
    ],
    "title": {
      "kind": "technical-claim-or-question",
      "max_lines": 1,
      "target_characters_latin": 64,
      "forbidden": [
        "generic-section-label",
        "decorative-subtitle",
        "repeated-takeaway"
      ]
    },
    "semantic_emphasis": {
      "maximum_red_phrases_per_slide": 2,
      "red_roles": ["central-answer", "replaced-assumption", "decisive-result"]
    }
  },
  "visual_tokens": {
    "canvas": {
      "width": 1280,
      "height": 720,
      "background": "#FFFFFF",
      "aspect_ratio": "16:9"
    },
    "measured_frame_px": {
      "title_anchor": {"x": 28, "y": 18},
      "title_rule": {"x": 28, "y": 66, "width": 1224, "height": 2},
      "content_field": {"x": 28, "y": 78, "width": 1224, "height": 560},
      "footer_band": {"x": 28, "y": 650, "width": 1224, "height": 54},
      "safe_bottom": 16
    },
    "palette": {
      "structure": "#002E7E",
      "supporting_blue": "#2F66B1",
      "pale_blue": "#EDF3FB",
      "border": "#C8D6EC",
      "semantic_red": "#D71920",
      "ink": "#17243A",
      "muted_ink": "#53647A",
      "white": "#FFFFFF",
      "module_green": "#E8F3E7",
      "module_yellow": "#FFF4CF",
      "module_lilac": "#F0EAF8",
      "gridline": "#DDE6F2"
    },
    "typography_px": {
      "cover_title": [52, 64],
      "content_title": [32, 38],
      "panel_title": [17, 21],
      "body": [14, 18],
      "figure_annotation": [12, 15],
      "metric": [40, 54],
      "footer_takeaway": [18, 22],
      "source": [10, 12]
    },
    "typography": {
      "title_weight": 700,
      "body_weight": 400,
      "numeric_weight": 700,
      "line_height_body": [1.2, 1.35],
      "font_stack": [
        "Arial",
        "Microsoft YaHei",
        "Noto Sans CJK SC",
        "Noto Sans",
        "sans-serif"
      ],
      "confirmed_reference_override": "Dense technical reference permits type below the generic baseline only after full-slide legibility review"
    },
    "geometry": {
      "grid_columns": 12,
      "baseline_px": 8,
      "gutter_px": [12, 16],
      "panel_radius_px": 4,
      "panel_border_px": 1,
      "panel_padding_px": [10, 14],
      "section_header_height_px": [28, 34],
      "number_marker_diameter_px": [24, 30],
      "dominant_visual_area_ratio": [0.56, 0.68],
      "reading_rail_area_ratio": [0.25, 0.32],
      "shadow": "none-or-very-subtle"
    }
  },
  "layout_selector": [
    {
      "when": "identity, one signature architecture, and three proof points",
      "archetype_id": "hero-architecture-triad"
    },
    {
      "when": "three prior limitations converge on one central question",
      "archetype_id": "problem-funnel-question"
    },
    {
      "when": "four contributions need parallel evidence and one conclusion",
      "archetype_id": "four-contribution-evidence"
    },
    {
      "when": "one architecture figure needs a numbered reading rail",
      "archetype_id": "architecture-main-reading-rail"
    },
    {
      "when": "two mechanisms or equations need one numbered explanation rail",
      "archetype_id": "dual-mechanism-numbered-rail"
    },
    {
      "when": "position, residual, or sequence information flows through three mechanisms",
      "archetype_id": "sequence-information-flow"
    },
    {
      "when": "a comparison table answers the efficiency or complexity question",
      "archetype_id": "comparison-table-conclusions"
    },
    {
      "when": "headline metrics, experiment table, and conditions must coexist",
      "archetype_id": "metric-scoreboard-method"
    },
    {
      "when": "one dominant qualitative figure and supporting figures prove behavior",
      "archetype_id": "evidence-gallery-observations"
    },
    {
      "when": "contribution, mechanism, impact, and discussion close the deck",
      "archetype_id": "synthesis-defense"
    }
  ],
  "slide_archetypes": [
    {
      "sequence_index": 1,
      "id": "hero-architecture-triad",
      "html_layout_class": "layout-hero-architecture-triad",
      "narrative_role": "identity",
      "required_regions": ["hero-title", "signature-architecture", "three-proof-points"]
    },
    {
      "sequence_index": 2,
      "id": "problem-funnel-question",
      "html_layout_class": "layout-problem-funnel-question",
      "narrative_role": "problem",
      "required_regions": ["three-limitations", "mechanism-evidence", "central-question"]
    },
    {
      "sequence_index": 3,
      "id": "four-contribution-evidence",
      "html_layout_class": "layout-four-contribution-evidence",
      "narrative_role": "novelty",
      "required_regions": ["four-contributions", "evidence-per-contribution", "takeaway"]
    },
    {
      "sequence_index": 4,
      "id": "architecture-main-reading-rail",
      "html_layout_class": "layout-architecture-main-reading-rail",
      "narrative_role": "architecture",
      "required_regions": ["dominant-architecture", "numbered-reading-rail", "legend"]
    },
    {
      "sequence_index": 5,
      "id": "dual-mechanism-numbered-rail",
      "html_layout_class": "layout-dual-mechanism-numbered-rail",
      "narrative_role": "mechanism",
      "required_regions": ["mechanism-a", "mechanism-b", "numbered-explanation"]
    },
    {
      "sequence_index": 6,
      "id": "sequence-information-flow",
      "html_layout_class": "layout-sequence-information-flow",
      "narrative_role": "representation",
      "required_regions": ["input-signal", "central-flow", "supporting-mechanisms"]
    },
    {
      "sequence_index": 7,
      "id": "comparison-table-conclusions",
      "html_layout_class": "layout-comparison-table-conclusions",
      "narrative_role": "comparison",
      "required_regions": ["dominant-table", "numbered-conclusions", "scope-note"]
    },
    {
      "sequence_index": 8,
      "id": "metric-scoreboard-method",
      "html_layout_class": "layout-metric-scoreboard-method",
      "narrative_role": "results",
      "required_regions": ["headline-metrics", "experiment-table", "method-conditions"]
    },
    {
      "sequence_index": 9,
      "id": "evidence-gallery-observations",
      "html_layout_class": "layout-evidence-gallery-observations",
      "narrative_role": "trust",
      "required_regions": ["dominant-evidence", "supporting-evidence", "numbered-observations"]
    },
    {
      "sequence_index": 10,
      "id": "synthesis-defense",
      "html_layout_class": "layout-synthesis-defense",
      "narrative_role": "synthesis",
      "required_regions": ["three-lens-summary", "conceptual-model", "discussion-questions"]
    }
  ],
  "component_recipes": {
    "title_and_rule": {
      "objects": ["text", "shape"],
      "editable": true,
      "rules": ["x-28-y-18", "one-line-navy-title", "rule-at-y-66"]
    },
    "technical_panel": {
      "objects": ["shape", "text"],
      "editable": "partial",
      "rules": ["one-pixel-border", "white-or-pale-fill", "no-heavy-shadow"]
    },
    "section_header": {
      "objects": ["shape", "text"],
      "editable": "partial",
      "rules": ["navy-fill", "white-text", "compact-height"]
    },
    "numbered_marker": {
      "objects": ["shape", "text"],
      "editable": "partial",
      "rules": ["navy-circle", "white-number", "left-aligned-reading-order"]
    },
    "architecture_diagram": {
      "objects": ["image", "shape"],
      "editable": "flattened-fidelity",
      "rules": ["pastel-module-fills", "navy-connectors", "one-red-path-maximum"]
    },
    "equation": {
      "objects": ["image", "text"],
      "editable": "flattened-fidelity",
      "rules": ["one-governing-equation", "pale-blue-field", "term-reading-guide"]
    },
    "table": {
      "objects": ["table", "text"],
      "editable": "flattened-fidelity",
      "rules": ["navy-header", "pale-alternating-rows", "highlight-decisive-cells"]
    },
    "chart": {
      "objects": ["chart", "text"],
      "editable": "flattened-fidelity",
      "rules": ["direct-labels", "navy-focal-series", "muted-comparators"]
    },
    "takeaway_footer": {
      "objects": ["shape", "text"],
      "editable": "partial",
      "rules": ["y-650-to-704", "pale-blue-fill", "one-red-semantic-phrase"]
    }
  },
  "density_budgets": {
    "cover_visible_words": [25, 50],
    "architecture_visible_words_outside_figure": [40, 75],
    "mechanism_visible_words_outside_diagrams": [45, 85],
    "comparison_visible_words_outside_table": [30, 65],
    "synthesis_visible_words": [65, 105],
    "numbered_rail_items": [3, 4],
    "max_dominant_visuals": 1,
    "max_supporting_evidence_units": 4
  },
  "deck_rhythm": {
    "canonical_sequence": [
      "hero-architecture-triad",
      "problem-funnel-question",
      "four-contribution-evidence",
      "architecture-main-reading-rail",
      "dual-mechanism-numbered-rail",
      "sequence-information-flow",
      "comparison-table-conclusions",
      "metric-scoreboard-method",
      "evidence-gallery-observations",
      "synthesis-defense"
    ],
    "forbid_adjacent_same_archetype": true,
    "max_dense_evidence_slides_in_sequence": 2
  },
  "representation_policy": {
    "representation": "html-tailwind-hybrid",
    "native_or_hybrid_editable": [
      "uniform-title",
      "uniform-panel-title",
      "uniform-body-copy",
      "uniform-metric",
      "plain-raster-image"
    ],
    "flattened_fidelity": [
      "complex-architecture",
      "equation",
      "chart",
      "table",
      "svg-icon",
      "connector-composition",
      "decorative-detail"
    ],
    "known_gaps": [
      "New HTML decks do not create native PowerPoint masters or animations",
      "Complex diagrams and equations are visually faithful shell content rather than semantically editable Office objects"
    ]
  },
  "project_contract": {
    "schema_version": 6,
    "requires_project_local_files": ["slide-dna.json", "qa-ledger.json"],
    "merge_order": [
      "powerpoint-office-like-baseline",
      "academic-engineering-blueprint",
      "project-specific-content-and-risk-flags"
    ]
  },
  "qa": {
    "fidelity_target": 90,
    "require_full_slide_render": true,
    "require_flattened_shell_review": true,
    "require_reopened_plugin_preview": true,
    "require_structural_round_trip": true,
    "require_source_notes": true,
    "hard_failures": [
      "wrong-aspect-ratio",
      "title-wrap",
      "content-outside-y-78-to-638",
      "footer-outside-y-650-to-704",
      "missing-glyph",
      "unintended-overlap",
      "unrendered-reopened-slide",
      "fidelity-score-below-90"
    ]
  }
}

{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "evoflux.documents",
  "version": "1.0.0",
  "description": "Skill-guided creation and verification of DOCX, XLSX, PPTX, and PDF documents.",
  "author": {
    "name": "EvoFlux contributors"
  },
  "license": "Apache-2.0",
  "keywords": ["documents", "docx", "xlsx", "pptx", "pdf"],
  "extensions": {
    "org.evoelsewhere.evoflux.builtin": {
      "preview_provider": "app.agent.builtin_plugins.documents.runtime:preview_provider",
      "python_extra": "documents",
      "legacy_skill_settings": ["docx", "xlsx", "pptx", "pdf"],
      "runtime_dependencies": [
        "python-docx",
        "openpyxl",
        "python-pptx",
        "pdfplumber",
        "pypdf",
        "pypdfium2",
        "Pillow",
        "reportlab"
      ]
    }
  }
}

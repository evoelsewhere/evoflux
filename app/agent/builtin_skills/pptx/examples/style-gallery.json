    {
      "id": "clean-professional",
      "title": "Clarity turns a complex program into a credible decision",
      "kind": "content",
      "style_preset": "clean-professional",
      "speaker_notes": "Diagnostic style sample: clean professional.",
      "sources": ["Adapted from ningzimu/codex-ppt-skill clean professional style brief"],
      "html": "<div class=\"safe\"><p class=\"preset-tag\" data-pptx-native=\"text\">Clean professional</p><h1 class=\"title\" data-pptx-native=\"text\" data-pptx-role=\"title\" style=\"margin-top:22px;max-width:1200px\">Clarity turns a complex program into a credible decision</h1><div class=\"process\" style=\"margin-top:68px\"><article class=\"preset-panel\" data-box><div class=\"preset-number\" data-pptx-native=\"text\">01</div><h3 data-pptx-native=\"text\">Frame the choice</h3><p data-pptx-native=\"text\">State the decision before the detail.</p></article><article class=\"preset-panel\" data-box><div class=\"preset-number\" data-pptx-native=\"text\">02</div><h3 data-pptx-native=\"text\">Show the evidence</h3><p data-pptx-native=\"text\">Use one structure with a clear reading path.</p></article><article class=\"preset-panel\" data-box><div class=\"preset-number\" data-pptx-native=\"text\">03</div><h3 data-pptx-native=\"text\">Land the action</h3><p data-pptx-native=\"text\">Translate insight into an accountable next step.</p></article></div></div>"
    },
    {
      "id": "creative-magazine",
      "title": "Make the shift impossible to ignore",
      "kind": "cover",
      "style_preset": "creative-magazine",
      "speaker_notes": "Diagnostic style sample: creative magazine.",
      "sources": ["Adapted from ningzimu/codex-ppt-skill creative magazine style brief"],
      "html": "<div class=\"safe\"><p class=\"preset-tag\" data-pptx-native=\"text\">Creative magazine / 02</p><div class=\"preset-stage\" style=\"margin-top:48px\"><h1 class=\"preset-display\" data-pptx-native=\"text\" data-pptx-role=\"title\" style=\"position:absolute;left:0;top:15px;max-width:940px\">MAKE<br>THE SHIFT</h1><div data-box style=\"position:absolute;right:0;top:0;width:430px;height:470px;background:#0b0b0d;color:white;padding:44px\"><p data-pptx-native=\"text\" style=\"font-size:22px;line-height:1.35;margin:0\">A premium editorial system uses scale, crop and one vivid accent—not a grid of polite boxes.</p><div style=\"position:absolute;left:-70px;bottom:72px;width:360px;height:38px;background:#ff2e72;transform:rotate(-7deg)\"></div></div><p data-pptx-native=\"text\" style=\"position:absolute;left:10px;bottom:10px;font-size:20px;max-width:620px\">Bold asymmetry • graphic tension • controlled color</p></div></div>"
    },
    {
      "id": "e-ink-magazine",
      "title": "Signal survives when the page learns to breathe",
      "kind": "content",
      "style_preset": "e-ink-magazine",
      "speaker_notes": "Diagnostic style sample: e-ink magazine.",
      "sources": ["Adapted from ningzimu/codex-ppt-skill e-ink magazine style brief"],
      "html": "<div class=\"safe\"><div style=\"display:flex;justify-content:space-between;align-items:center\"><p class=\"preset-tag\" data-pptx-native=\"text\">Field notes / 03</p><p class=\"preset-micro\" data-pptx-native=\"text\">Ideas • systems • consequence</p></div><div class=\"hero\" style=\"gap:100px\"><section data-box><h1 class=\"title\" data-pptx-native=\"text\" data-pptx-role=\"title\">Signal survives when the page learns to breathe</h1><p class=\"subtitle\" data-pptx-native=\"text\">Editorial rhythm alternates a strong voice with enough quiet space to make it memorable.</p></section><aside class=\"preset-stage\" data-box><div style=\"position:absolute;inset:60px 20px;border-top:2px solid #111;border-bottom:2px solid #111\"></div><p class=\"preset-number\" data-pptx-native=\"text\" style=\"position:absolute;left:40px;top:95px;font-size:148px\">72%</p><p data-pptx-native=\"text\" style=\"position:absolute;left:48px;top:260px;font-size:20px;max-width:360px\">of attention follows hierarchy before it follows detail.</p><p class=\"preset-micro\" data-pptx-native=\"text\" style=\"position:absolute;right:20px;bottom:24px\">EVOFLUX EDITION</p></aside></div></div>"
    },
    {
      "id": "data-dashboard",
      "title": "One metric explains the week; the rest explain why",
      "kind": "data",
      "style_preset": "data-dashboard",
      "speaker_notes": "Diagnostic style sample: data dashboard.",
      "sources": ["Adapted from ningzimu/codex-ppt-skill data dashboard style brief"],
      "html": "<div class=\"safe\"><p class=\"preset-tag\" data-pptx-native=\"text\">Data dashboard</p><h1 class=\"title\" data-pptx-native=\"text\" data-pptx-role=\"title\" style=\"margin-top:18px\">One metric explains the week; the rest explain why</h1><div class=\"three\" style=\"margin-top:38px\"><div class=\"preset-panel\" data-box><p class=\"label\" data-pptx-native=\"text\">Activation</p><div class=\"metric\" data-pptx-native=\"text\">68%</div><p data-pptx-native=\"text\" style=\"font-size:18px;color:#10b981\">↑ 8.4 pts</p></div><div class=\"preset-panel\" data-box><p class=\"label\" data-pptx-native=\"text\">Time to value</p><div class=\"metric\" data-pptx-native=\"text\">2.3d</div><p data-pptx-native=\"text\" style=\"font-size:18px;color:#10b981\">↓ 0.7 day</p></div><div class=\"preset-panel\" data-box><p class=\"label\" data-pptx-native=\"text\">Retention</p><div class=\"metric\" data-pptx-native=\"text\">91%</div><p data-pptx-native=\"text\" style=\"font-size:18px;color:#64748b\">stable</p></div></div><div class=\"preset-panel\" data-box style=\"margin-top:24px;height:245px;display:grid;grid-template-columns:280px 1fr;gap:44px\"><div><h3 data-pptx-native=\"text\">Activation is now the leading signal</h3><p data-pptx-native=\"text\">A simpler first run removed the steepest drop-off.</p></div><div style=\"display:flex;align-items:end;gap:24px;padding:24px 10px 10px;border-left:1px solid #dce6f2;border-bottom:1px solid #dce6f2\"><i style=\"width:70px;height:42%;background:#cfe0ff\"></i><i style=\"width:70px;height:55%;background:#9fc2ff\"></i><i style=\"width:70px;height:67%;background:#68a0ff\"></i><i style=\"width:70px;height:82%;background:#2563eb\"></i><i style=\"width:70px;height:91%;background:#06b6d4\"></i></div></div></div>"
    },
    {
      "id": "retro-flat-illustration",
      "title": "A familiar system can still lead somewhere new",
      "kind": "process",
      "style_preset": "retro-flat-illustration",
      "speaker_notes": "Diagnostic style sample: retro flat illustration.",
      "sources": ["Adapted from ningzimu/codex-ppt-skill retro flat illustration style brief"],
      "html": "<div class=\"safe\"><p class=\"preset-tag\" data-pptx-native=\"text\">Retro flat illustration</p><h1 class=\"title\" data-pptx-native=\"text\" data-pptx-role=\"title\" style=\"margin-top:22px;max-width:1120px\">A familiar system can still lead somewhere new</h1><svg viewBox=\"0 0 1432 260\" style=\"margin-top:35px;width:100%;height:260px\" aria-hidden=\"true\"><rect x=\"0\" y=\"190\" width=\"1432\" height=\"70\" fill=\"#95E1D3\"/><circle cx=\"1260\" cy=\"65\" r=\"48\" fill=\"#F9CA24\" stroke=\"#34495E\" stroke-width=\"4\"/><path d=\"M0 195 C240 95 430 210 650 125 S1040 160 1432 82\" fill=\"none\" stroke=\"#34495E\" stroke-width=\"5\"/><g fill=\"#E17055\" stroke=\"#34495E\" stroke-width=\"4\"><rect x=\"155\" y=\"118\" width=\"125\" height=\"90\"/><rect x=\"615\" y=\"80\" width=\"150\" height=\"128\"/><rect x=\"1085\" y=\"112\" width=\"132\" height=\"96\"/></g><g fill=\"#FFF9E7\"><rect x=\"180\" y=\"140\" width=\"28\" height=\"38\"/><rect x=\"652\" y=\"108\" width=\"34\" height=\"45\"/><rect x=\"1120\" y=\"136\" width=\"30\" height=\"40\"/></g></svg><div class=\"three\" style=\"margin-top:24px\"><div class=\"preset-panel\" data-box><h3 data-pptx-native=\"text\">Keep the story</h3></div><div class=\"preset-panel\" data-box><h3 data-pptx-native=\"text\">Change the route</h3></div><div class=\"preset-panel\" data-box><h3 data-pptx-native=\"text\">Arrive with evidence</h3></div></div></div>"
    },
    {
      "id": "handdrawn-technical",
      "title": "A small diagram can make the mechanism obvious",
      "kind": "architecture",
      "style_preset": "handdrawn-technical",
      "speaker_notes": "Diagnostic style sample: hand-drawn technical explanation.",
      "sources": ["Adapted from ningzimu/codex-ppt-skill hand-drawn technical style brief"],
      "html": "<div class=\"safe\"><p class=\"preset-tag\" data-pptx-native=\"text\">Hand-drawn technical</p><h1 class=\"title\" data-pptx-native=\"text\" data-pptx-role=\"title\" style=\"margin-top:18px;max-width:1120px\">A small diagram can make the mechanism obvious</h1><div class=\"preset-stage\" style=\"margin-top:28px\"><svg viewBox=\"0 0 1432 480\" style=\"width:100%;height:480px\"><path d=\"M245 250 C420 170 520 174 660 235 S930 312 1150 210\" fill=\"none\" stroke=\"#2F3437\" stroke-width=\"4\" stroke-dasharray=\"15 10\"/><g stroke=\"#2F3437\" stroke-width=\"4\"><ellipse cx=\"245\" cy=\"250\" rx=\"120\" ry=\"72\" fill=\"#BFD7F1\"/><ellipse cx=\"700\" cy=\"245\" rx=\"140\" ry=\"82\" fill=\"#CFE2D1\"/><ellipse cx=\"1160\" cy=\"210\" rx=\"125\" ry=\"74\" fill=\"#F4C7B8\"/></g></svg><p data-pptx-native=\"text\" style=\"position:absolute;left:150px;top:215px;font-size:24px\">Input</p><p data-pptx-native=\"text\" style=\"position:absolute;left:620px;top:210px;font-size:24px\">Reasoning</p><p data-pptx-native=\"text\" style=\"position:absolute;left:1090px;top:175px;font-size:24px\">Evidence</p><div class=\"preset-note\" data-box style=\"position:absolute;right:60px;bottom:18px;width:430px\"><p data-pptx-native=\"text\" style=\"font-size:20px;margin:0\">Show only the relationship the audience must understand now.</p></div></div></div>"
    },
    {
      "id": "handdrawn-whiteboard",
      "title": "Teach the idea in the order people actually learn it",
      "kind": "process",
      "style_preset": "handdrawn-whiteboard",
      "speaker_notes": "Diagnostic style sample: hand-drawn whiteboard.",
      "sources": ["Adapted from ningzimu/codex-ppt-skill hand-drawn whiteboard style brief"],
      "html": "<div class=\"safe\"><p class=\"preset-tag\" data-pptx-native=\"text\">Whiteboard / workshop</p><h1 class=\"title\" data-pptx-native=\"text\" data-pptx-role=\"title\" style=\"margin-top:20px\">Teach the idea in the order people actually learn it</h1><div class=\"flow\" style=\"margin-top:72px;align-items:center\"><article class=\"preset-panel\" data-box style=\"flex:1\"><h3 data-pptx-native=\"text\">1. Name it</h3><p data-pptx-native=\"text\">Start with the simplest useful definition.</p></article><div data-pptx-native=\"text\" style=\"font-size:54px;color:#3498db\">→</div><article class=\"preset-panel\" data-box style=\"flex:1\"><h3 data-pptx-native=\"text\">2. Draw it</h3><p data-pptx-native=\"text\">Make the relationship visible.</p></article><div data-pptx-native=\"text\" style=\"font-size:54px;color:#e74c3c\">→</div><article class=\"preset-panel\" data-box style=\"flex:1\"><h3 data-pptx-native=\"text\">3. Use it</h3><p data-pptx-native=\"text\">Apply the rule to one concrete case.</p></article></div><div class=\"preset-note\" data-box style=\"margin:54px auto 0;width:720px\"><p data-pptx-native=\"text\" style=\"font-size:22px;margin:0;text-align:center\">Friendly is not the same as messy.</p></div></div>"
    },
    {
      "id": "warm-handmade",
      "title": "Progress feels real when every voice has a place",
      "kind": "content",
      "style_preset": "warm-handmade",
      "speaker_notes": "Diagnostic style sample: warm handmade.",
      "sources": ["Adapted from ningzimu/codex-ppt-skill warm handmade style brief"],
      "html": "<div class=\"safe\"><p class=\"preset-tag\" data-pptx-native=\"text\">Warm handmade</p><h1 class=\"title\" data-pptx-native=\"text\" data-pptx-role=\"title\" style=\"margin-top:20px;max-width:1080px\">Progress feels real when every voice has a place</h1><div class=\"three\" style=\"margin-top:76px\"><article class=\"preset-panel\" data-box><div class=\"preset-number\" data-pptx-native=\"text\">01</div><h3 data-pptx-native=\"text\">Listen closely</h3><p data-pptx-native=\"text\">Find the need behind the request.</p></article><article class=\"preset-panel\" data-box><div class=\"preset-number\" data-pptx-native=\"text\">02</div><h3 data-pptx-native=\"text\">Build together</h3><p data-pptx-native=\"text\">Make ownership visible in the work.</p></article><article class=\"preset-panel\" data-box><div class=\"preset-number\" data-pptx-native=\"text\">03</div><h3 data-pptx-native=\"text\">Share the proof</h3><p data-pptx-native=\"text\">Celebrate the outcome and the learning.</p></article></div></div>"
    },
    {
      "id": "scientific-defense",
      "title": "The mechanism is supported by three independent signals",
      "kind": "data",
      "style_preset": "scientific-defense",
      "speaker_notes": "Diagnostic style sample: scientific defense.",
      "sources": ["Adapted from ningzimu/codex-ppt-skill scientific defense style brief"],
      "html": "<div class=\"safe\"><p class=\"preset-tag\" data-pptx-native=\"text\">Scientific defense</p><h1 class=\"title\" data-pptx-native=\"text\" data-pptx-role=\"title\" style=\"margin-top:18px\">The mechanism is supported by three independent signals</h1><div class=\"three\" style=\"margin-top:42px\"><article class=\"preset-panel\" data-box><h3 data-pptx-native=\"text\">01 • Controlled test</h3><div style=\"height:130px;background:linear-gradient(135deg,#eaf2ff,#d5e6ff);margin:18px 0\"></div><p data-pptx-native=\"text\">The effect persists under controlled conditions.</p></article><article class=\"preset-panel\" data-box><h3 data-pptx-native=\"text\">02 • Field evidence</h3><div style=\"height:130px;background:repeating-linear-gradient(90deg,#0b5cad 0 28px,#eaf2ff 28px 54px);margin:18px 0\"></div><p data-pptx-native=\"text\">Observed behavior follows the predicted direction.</p></article><article class=\"preset-panel\" data-box><h3 data-pptx-native=\"text\">03 • Replication</h3><div style=\"height:130px;background:radial-gradient(circle,#b5121b 0 8%,transparent 9%),#eaf2ff;background-size:42px 42px;margin:18px 0\"></div><p data-pptx-native=\"text\">The result repeats across independent runs.</p></article></div><div class=\"preset-note\" data-box style=\"margin-top:28px\"><p data-pptx-native=\"text\" style=\"font-size:22px;margin:0\">Conclusion: converging evidence reduces the likelihood of a measurement artifact.</p></div></div>"
    },
    {
      "id": "mckinsey",
      "title": "The operating model must make the decision path visible",
      "kind": "architecture",
      "style_preset": "mckinsey",
      "speaker_notes": "Diagnostic style sample: consulting.",
      "sources": ["Adapted from ningzimu/codex-ppt-skill consulting style brief"],
      "html": "<div class=\"safe\"><div style=\"display:flex;justify-content:space-between\"><p class=\"preset-tag\" data-pptx-native=\"text\">Operating model</p><p class=\"preset-micro\" data-pptx-native=\"text\">Strategy / structure / impact</p></div><h1 class=\"title\" data-pptx-native=\"text\" data-pptx-role=\"title\" style=\"margin-top:22px;max-width:1080px\">The operating model must make the decision path visible</h1><div class=\"preset-stage\" style=\"margin-top:25px\"><div class=\"preset-axis horizontal\" style=\"top:245px\"></div><div class=\"preset-axis vertical\" style=\"left:716px\"></div><p class=\"preset-display\" data-pptx-raster style=\"position:absolute;left:40px;top:92px;font-size:132px\">SYSTEM</p><div class=\"preset-note\" data-box style=\"position:absolute;right:40px;top:68px;width:370px\"><p class=\"preset-micro\" data-pptx-native=\"text\">Decision logic</p><p data-pptx-native=\"text\" style=\"font-size:21px\">One owner, one gate, one evidence trail.</p></div><p class=\"preset-micro\" data-pptx-native=\"text\" style=\"position:absolute;left:50px;bottom:48px\">INPUT / KNOWLEDGE</p><p class=\"preset-micro\" data-pptx-native=\"text\" style=\"position:absolute;right:52px;bottom:48px\">OUTPUT / VERIFIED ACTION</p></div></div>"
    },
    {
      "id": "party-government-red",
      "title": "Four priorities turn commitment into measurable delivery",
      "kind": "process",
      "style_preset": "party-government-red",
      "speaker_notes": "Diagnostic style sample: party and government red. No official symbol is used or implied.",
      "sources": ["Adapted from ningzimu/codex-ppt-skill party and government red style brief"],
      "html": "<div class=\"safe\"><div class=\"eyebrow-rule\"></div><p class=\"preset-tag\" data-pptx-native=\"text\">Formal delivery system</p><h1 class=\"title\" data-pptx-native=\"text\" data-pptx-role=\"title\" style=\"margin-top:24px;max-width:1180px\">Four priorities turn commitment into measurable delivery</h1><div class=\"process\" style=\"margin-top:74px\"><article class=\"preset-panel\" data-box><div class=\"preset-number\" data-pptx-native=\"text\">01</div><h3 data-pptx-native=\"text\">Understand</h3></article><article class=\"preset-panel\" data-box><div class=\"preset-number\" data-pptx-native=\"text\">02</div><h3 data-pptx-native=\"text\">Coordinate</h3></article><article class=\"preset-panel\" data-box><div class=\"preset-number\" data-pptx-native=\"text\">03</div><h3 data-pptx-native=\"text\">Execute</h3></article><article class=\"preset-panel\" data-box><div class=\"preset-number\" data-pptx-native=\"text\">04</div><h3 data-pptx-native=\"text\">Verify</h3></article></div><div class=\"preset-note\" data-box style=\"margin-top:34px\"><p data-pptx-native=\"text\" style=\"font-size:22px;margin:0;text-align:center\">Formal does not require ceremonial clutter; the message remains primary.</p></div></div>"
    },
    {
      "id": "teaching-courseware",
      "title": "Learners need a sequence, an example, and a rule they can reuse",
      "kind": "content",
      "style_preset": "teaching-courseware",
      "speaker_notes": "Diagnostic style sample: teaching courseware.",
      "sources": ["Adapted from ningzimu/codex-ppt-skill teaching courseware style brief"],
      "html": "<div class=\"safe\"><p class=\"preset-tag\" data-pptx-native=\"text\">Teaching courseware</p><h1 class=\"title\" data-pptx-native=\"text\" data-pptx-role=\"title\" style=\"margin-top:18px;max-width:1260px\">Learners need a sequence, an example, and a rule they can reuse</h1><div class=\"three\" style=\"margin-top:58px\"><article class=\"preset-panel\" data-box><div class=\"preset-number\" data-pptx-native=\"text\">1</div><h3 data-pptx-native=\"text\">Sequence</h3><p data-pptx-native=\"text\">Introduce each idea only when the prior one creates the need for it.</p></article><article class=\"preset-panel\" data-box><div class=\"preset-number\" data-pptx-native=\"text\">2</div><h3 data-pptx-native=\"text\">Example</h3><p data-pptx-native=\"text\">Ground the abstraction in a case the audience can inspect.</p></article><article class=\"preset-panel\" data-box><div class=\"preset-number\" data-pptx-native=\"text\">3</div><h3 data-pptx-native=\"text\">Reusable rule</h3><p data-pptx-native=\"text\">Close with a principle that transfers to the next problem.</p></article></div><div class=\"preset-note\" data-box style=\"margin-top:34px\"><p data-pptx-native=\"text\" style=\"font-size:22px;margin:0\">The layout follows the learning objective—not a repeated three-column default.</p></div></div>"
    }
  ]
}

{
  "schema_version": 1,
  "id": "research-paper-briefing",
  "name": "Research Paper Evidence Briefing",
  "evidence_basis": {
    "reference_slide_count": 10,
    "reference_paper": "Attention Is All You Need",
    "reference_url": "https://arxiv.org/abs/1706.03762",
    "observed_sequence": [
      "identity-and-central-claim",
      "prior-limitations-and-research-question",
      "contributions",
      "architecture",
      "core-equation",
      "supporting-mechanisms",
      "efficiency-comparison",
      "results-and-training-cost",
      "qualitative-evidence",
      "synthesis-and-discussion"
    ]
  },
  "communication_grammar": {
    "slide_equation": [
      "claim",
      "evidence",
      "reading_guide",
      "implication",
      "takeaway"
    ],
    "content_roles": [
      "premise",
      "mechanism",
      "evidence",
      "implication",
      "caveat"
    ],
    "title": {
      "kind": "audience-facing-claim",
      "max_lines": 1,
      "target_characters_latin": 58,
      "forbidden": [
        "generic-section-label",
        "production-note",
        "repeated-takeaway"
      ]
    },
    "takeaway": {
      "max_sentences": 1,
      "semantic_red_phrases": 1,
      "must_add_new_meaning": true
    }
  },
  "visual_tokens": {
    "canvas": {
      "width": 1280,
      "height": 720,
      "background": "#fbfaf7",
      "outer_margin_x": 32,
      "outer_margin_top": 24,
      "outer_margin_bottom": 22
    },
    "grid": {
      "columns": 12,
      "baseline": 8,
      "gutter_min": 12,
      "gutter_max": 16
    },
    "palette": {
      "structure": "#073b82",
      "supporting_blue": "#2f6eb5",
      "semantic_emphasis": "#d92d20",
      "ink": "#17243a",
      "muted_ink": "#53647a",
      "line": "#a9c3e5",
      "soft_line": "#d9e5f3",
      "soft_blue": "#f2f7fc",
      "caveat": "#fff7d6",
      "module_green": "#eef7ed",
      "module_lilac": "#f2eefb"
    },
    "typography_px": {
      "cover_title": [62, 72],
      "content_title": [38, 44],
      "panel_title": [18, 22],
      "body": [18, 21],
      "figure_annotation": [15, 17],
      "metric": [44, 60],
      "source": [12, 14]
    },
    "geometry": {
      "title_rule_px": 2,
      "panel_radius_px": 7,
      "panel_padding_px": [10, 14],
      "dominant_visual_area_ratio": [0.58, 0.68],
      "reading_rail_area_ratio": [0.24, 0.32],
      "conclusion_band_height_ratio": [0.07, 0.1]
    }
  },
  "layout_selector": [
    {
      "when": "paper identity plus one signature figure",
      "layout_id": "cover-split"
    },
    {
      "when": "one decisive claim plus one proof",
      "layout_id": "claim-evidence"
    },
    {
      "when": "three prior limitations ending in one question",
      "layout_id": "problem-funnel"
    },
    {
      "when": "causal sequence or dependency is the argument",
      "layout_id": "process-cascade"
    },
    {
      "when": "three distinct contributions with evidence",
      "layout_id": "contribution-triptych"
    },
    {
      "when": "signature architecture plus reading guide",
      "layout_id": "architecture-main-aside"
    },
    {
      "when": "two related mechanisms plus interpretation",
      "layout_id": "mechanism-two-plus-one"
    },
    {
      "when": "one equation is the conceptual hinge",
      "layout_id": "equation-focus"
    },
    {
      "when": "one table or chart answers the comparison",
      "layout_id": "evidence-comparison"
    },
    {
      "when": "two or three headline metrics plus experiment details",
      "layout_id": "results-scoreboard"
    },
    {
      "when": "ablation matrix plus caveats",
      "layout_id": "ablation-matrix"
    },
    {
      "when": "one dominant qualitative figure plus supporting figures",
      "layout_id": "interpretability-gallery"
    },
    {
      "when": "historical sequence changes the conclusion",
      "layout_id": "timeline-impact"
    },
    {
      "when": "contribution, mechanism, and discussion close the deck",
      "layout_id": "synthesis-three-lens"
    }
  ],
  "layouts": [
    {
      "id": "cover-split",
      "css_class": "layout-cover-split",
      "dominant_role": "identity",
      "required_roles": ["claim", "signature-visual", "citation"],
      "max_supporting_units": 3
    },
    {
      "id": "claim-evidence",
      "css_class": "layout-claim-evidence",
      "dominant_role": "claim",
      "required_roles": ["claim", "evidence", "implication"],
      "max_supporting_units": 2
    },
    {
      "id": "problem-funnel",
      "css_class": "layout-problem-funnel",
      "dominant_role": "premise",
      "required_roles": ["limitations", "comparison", "research-question"],
      "max_supporting_units": 4
    },
    {
      "id": "process-cascade",
      "css_class": "layout-process-cascade",
      "dominant_role": "causality",
      "required_roles": ["stages", "mechanism", "implication"],
      "max_supporting_units": 4
    },
    {
      "id": "contribution-triptych",
      "css_class": "layout-contribution-triptych",
      "dominant_role": "novelty",
      "required_roles": ["architecture", "efficiency", "effectiveness"],
      "max_supporting_units": 3
    },
    {
      "id": "architecture-main-aside",
      "css_class": "layout-architecture-main-aside",
      "dominant_role": "mechanism",
      "required_roles": ["architecture-figure", "reading-guide"],
      "max_supporting_units": 4
    },
    {
      "id": "mechanism-two-plus-one",
      "css_class": "layout-mechanism-two-plus-one",
      "dominant_role": "mechanism",
      "required_roles": ["mechanism-a", "mechanism-b", "interpretation"],
      "max_supporting_units": 3
    },
    {
      "id": "equation-focus",
      "css_class": "layout-equation-focus",
      "dominant_role": "mechanism",
      "required_roles": ["equation", "term-decomposition", "implication"],
      "max_supporting_units": 4
    },
    {
      "id": "evidence-comparison",
      "css_class": "layout-evidence-comparison",
      "dominant_role": "evidence",
      "required_roles": ["comparison", "reading-guide", "takeaway"],
      "max_supporting_units": 4
    },
    {
      "id": "results-scoreboard",
      "css_class": "layout-results-scoreboard",
      "dominant_role": "evidence",
      "required_roles": ["headline-metrics", "experiment-detail", "conditions"],
      "max_supporting_units": 5
    },
    {
      "id": "ablation-matrix",
      "css_class": "layout-ablation-matrix",
      "dominant_role": "trust",
      "required_roles": ["ablation", "interpretation", "caveat"],
      "max_supporting_units": 4
    },
    {
      "id": "interpretability-gallery",
      "css_class": "layout-interpretability-gallery",
      "dominant_role": "trust",
      "required_roles": ["dominant-figure", "supporting-figures", "claim-captions"],
      "max_supporting_units": 4
    },
    {
      "id": "timeline-impact",
      "css_class": "layout-timeline-impact",
      "dominant_role": "implication",
      "required_roles": ["milestones", "impact", "takeaway"],
      "max_supporting_units": 4
    },
    {
      "id": "synthesis-three-lens",
      "css_class": "layout-synthesis-three-lens",
      "dominant_role": "synthesis",
      "required_roles": ["contribution", "mechanism", "discussion"],
      "max_supporting_units": 5
    }
  ],
  "component_recipes": {
    "header": {
      "objects": ["text", "shape"],
      "editable": true,
      "rules": ["one-line-claim", "navy-title", "two-pixel-rule"]
    },
    "paper_figure": {
      "objects": ["image"],
      "editable": "replaceable",
      "rules": ["preserve-aspect-ratio", "crop-dead-margin", "claim-caption"]
    },
    "architecture_diagram": {
      "objects": ["image", "shape"],
      "editable": "partial",
      "rules": ["three-connector-semantics-maximum", "one-red-path-maximum"]
    },
    "equation": {
      "objects": ["image", "text"],
      "editable": "partial",
      "rules": ["one-governing-equation", "two-to-four-term-explanations"]
    },
    "table": {
      "objects": ["table", "text"],
      "editable": true,
      "rules": ["one-question", "six-rows-default", "highlight-decisive-cells"]
    },
    "chart": {
      "objects": ["chart", "text"],
      "editable": true,
      "rules": ["direct-labels", "one-saturated-series", "show-units"]
    },
    "reading_rail": {
      "objects": ["shape", "text"],
      "editable": true,
      "rules": ["two-to-four-items", "claim-plus-one-sentence"]
    },
    "takeaway": {
      "objects": ["shape", "text"],
      "editable": true,
      "rules": ["one-sentence", "one-red-phrase", "new-meaning"]
    },
    "caveat": {
      "objects": ["shape", "text"],
      "editable": true,
      "rules": ["pale-yellow", "muted-ink", "never-semantic-red"]
    }
  },
  "density_budgets": {
    "cover_visible_words": [25, 45],
    "mechanism_visible_words_outside_figure": [45, 80],
    "evidence_visible_words_outside_labels": [35, 65],
    "synthesis_visible_words": [70, 110],
    "reading_rail_items": [2, 4],
    "reading_rail_words_per_item": [18, 28],
    "max_dominant_visuals": 1,
    "max_supporting_evidence_units": 3
  },
  "deck_rhythm": {
    "forbid_adjacent_same_layout": true,
    "max_dense_evidence_slides_in_sequence": 2,
    "preferred_energy_cycle": [
      "broad",
      "directional",
      "comparative",
      "deep-focus",
      "evidence",
      "synthesis"
    ]
  },
  "editability_contract": {
    "handoff_default_profile": "hybrid",
    "view_only_profile": "fidelity",
    "fully_editable_profile": "native",
    "minimum_editable_visible_text_ratio": 0.7,
    "reported_numbers_must_be_editable": true,
    "native_components": [
      "title",
      "panel-title",
      "body-copy",
      "metric",
      "table",
      "chart",
      "reading-rail",
      "takeaway",
      "source-note"
    ],
    "visual_shell_components": [
      "paper-figure",
      "attention-map",
      "complex-equation",
      "complex-architecture",
      "decorative-detail"
    ]
  },
  "qa": {
    "require_full_slide_render": true,
    "require_round_trip_render": true,
    "require_source_notes": true,
    "reject_title_wrap": true,
    "reject_unintended_overlap": true,
    "reject_repeated_takeaway": true,
    "hybrid_requires_reference_html": true,
    "max_changed_pixel_ratio": 0.02,
    "max_mean_absolute_error": 0.01
  }
}

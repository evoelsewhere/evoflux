{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5180", "--strictPort"],
      "cwd": "web",
      "port": 5180,
      "autoPort": false
    },
    {
      "name": "web-session2",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5182"],
      "cwd": "web",
      "port": 5182,
      "autoPort": true
    },
    {
      "name": "web-plan",
      "runtimeExecutable": "env",
      "runtimeArgs": ["VITE_API_PROXY_TARGET=http://localhost:8001", "npm", "run", "dev", "--", "--port", "5181", "--strictPort"],
      "cwd": ".claude/worktrees/plan-review-ux/web",
      "port": 5181,
      "autoPort": false
    },
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "app.server:app", "--reload", "--reload-dir", "app"],
      "port": 8000,
      "autoPort": false
    }
  ]
}

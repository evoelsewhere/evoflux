{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window and chat windows: window chrome, zoom, the folder picker, and opening folders and links in the OS, and system notifications, and opening files from the Files tool with their default app.",
  "windows": [
    "main",
    "chat-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    "opener:allow-reveal-item-in-dir",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:webview:allow-set-webview-zoom",
    "opener:default",
    "notification:default"
  ]
}

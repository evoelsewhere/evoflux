{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the app's own webview. Scoped by webview rather than window on purpose: a window pattern grants these permissions to every webview inside that window, and the in-app browser's pages are child webviews of 'main', so any page it loaded from an allowed remote URL (a previewed dev server) could invoke the app's file and backend commands. The browser's webviews are labelled 'browser-*' and match nothing here.",
  "webviews": ["main", "main-*"],
  "local": true,
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-set-theme",
    "core:webview:default",
    "core:webview:allow-create-webview",
    "core:window:allow-set-focus",
    "core:webview:allow-set-webview-position",
    "core:webview:allow-set-webview-size",
    "core:webview:allow-set-webview-focus",
    "core:webview:allow-set-webview-zoom",
    "core:webview:allow-webview-hide",
    "core:webview:allow-webview-show",
    "core:webview:allow-webview-close",
    "core:webview:allow-clear-all-browsing-data",
    "core:app:default",
    "core:event:default",
    "core:resources:default",
    "dialog:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "notification:default",
    "opener:default",
    "log:default",
    "allow-request-voice-permissions",
    "allow-save-workspace-file",
    "allow-backend-health",
    "allow-backend-logs-path",
    "allow-app-backend-status",
    "allow-app-retry-backend",
    "allow-app-reveal-backend-log",
    "allow-app-check-for-updates",
    "allow-app-install-update",
    "allow-app-remove-backend-server",
    "allow-app-save-backend-server",
    "allow-app-use-external-backend",
    "allow-app-use-bundled-backend",
    "allow-app-new-window",
    "allow-app-browser-webview-navigate",
    "allow-app-browser-webview-command",
    "allow-app-browser-webview-url",
    "allow-app-browser-webview-agent-action",
    "allow-app-browser-webview-bind-shortcuts",
    "allow-app-browser-webview-is-loading",
    "allow-app-computer-action",
    "allow-app-computer-frame",
    "allow-app-computer-stop",
    "allow-app-computer-resume",
    "allow-app-computer-reveal",
    "allow-app-computer-list-apps",
    "allow-app-computer-permissions",
    "allow-app-computer-request-permission",
    "allow-app-computer-restart",
    "allow-set-tray-session",
    "allow-list-workspace-files",
    "allow-read-workspace-file",
    "allow-list-directory",
    "allow-open-workspace-file-with-handle",
    "allow-open-workspace-root-with-handle",
    "allow-reveal-workspace-path-with-handle",
    "allow-start-file-watcher",
    "allow-stop-file-watcher",
    "allow-list-workspace-openers",
    "allow-open-workspace-with"
  ]
}

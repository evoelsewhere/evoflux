            {"gate": "Render", "confidence": 0.79, "owner": "Visual QA", "planned": 8, "actual": 9, "status": "At risk"},
            {"gate": "Inspect", "confidence": 0.84, "owner": "Reviewer", "planned": 4, "actual": 4, "status": "On track"},
            {"gate": "Repair", "confidence": 0.91, "owner": "Agent", "planned": 6, "actual": 7, "status": "Blocked"},
            {"gate": "Deliver", "confidence": 0.96, "owner": "EvoFlux", "planned": 2, "actual": 1.5, "status": "On track"}

          "rows": [
            {"gate": "Plan", "confidence": 0.38, "owner": "Product", "planned": 6, "actual": 5.5, "status": "Done"},
            {"gate": "Schema", "confidence": 0.52, "owner": "Platform", "planned": 8, "actual": 8.5, "status": "Done"},

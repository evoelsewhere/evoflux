            {"feature": "Charts and conditional formatting", "create": "Native", "edit": "Native / partial"},
            {"feature": "Validation, comments, names", "create": "Native", "edit": "Native"},
            {"feature": "Pivot tables and slicers", "create": "Template-first", "edit": "Preserve-only"},
            {"feature": "VBA and external queries", "create": "Unsupported", "edit": "Preserve-only"}
          ]
        }
      ]
    }
